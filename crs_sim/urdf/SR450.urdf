<?xml version="1.0"?>
<!-- Bosch SR450 SCARA, generated by tools/make_bosch_urdf.py from the
     kinematics of ctu_bosch_sr450.RobotBosch: the flange frame is
     RobotBosch.flange_pose(q). The link shapes are boxes / cylinders
     approximating the real arm, the adapter and the hoop are the CAD
     models. joint4 is relative to arm 2 (see RobotBosch.model_q). -->
<robot name="SR450">
    <link name="base_link">
        <inertial><mass value="1"/><inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/></inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><mesh filename="meshes/sr450_base_link.stl" scale="0.001 0.001 0.001"/></geometry>
            <material name="base_link_color"><color rgba="0.3 0.3 0.32 1"/></material>
        </visual>
    </link>
    <joint name="joint1" type="revolute">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="link_1"/>
        <axis xyz="0 0 1"/>
        <limit effort="100" velocity="10" lower="-1.483524" upper="1.483524"/>
    </joint>
    <link name="link_1">
        <inertial><mass value="1"/><inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/></inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><mesh filename="meshes/sr450_link_1.stl" scale="0.001 0.001 0.001"/></geometry>
            <material name="link_1_color"><color rgba="0.72 0.78 0.3 1"/></material>
        </visual>
    </link>
    <joint name="joint2" type="revolute">
        <origin xyz="0.25 0 0" rpy="0 0 0"/>
        <parent link="link_1"/>
        <child link="link_2"/>
        <axis xyz="0 0 1"/>
        <limit effort="100" velocity="10" lower="-2.094405" upper="2.094405"/>
    </joint>
    <link name="link_2">
        <inertial><mass value="1"/><inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/></inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><mesh filename="meshes/sr450_link_2.stl" scale="0.001 0.001 0.001"/></geometry>
            <material name="link_2_color"><color rgba="0.72 0.78 0.3 1"/></material>
        </visual>
    </link>
    <joint name="joint3" type="prismatic">
        <origin xyz="0.2 0 0.5" rpy="0 0 0"/>
        <parent link="link_2"/>
        <child link="link_3"/>
        <axis xyz="0 0 1"/>
        <limit effort="100" velocity="10" lower="-0.330000" upper="0.005000"/>
    </joint>
    <link name="link_3">
        <inertial><mass value="1"/><inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/></inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><mesh filename="meshes/sr450_link_3.stl" scale="0.001 0.001 0.001"/></geometry>
            <material name="link_3_color"><color rgba="0.8 0.8 0.82 1"/></material>
        </visual>
    </link>
    <joint name="joint4" type="revolute">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="link_3"/>
        <child link="link_4"/>
        <axis xyz="0 0 1"/>
        <limit effort="100" velocity="10" lower="-20.000000" upper="20.000000"/>
    </joint>
    <link name="link_4">
        <inertial><mass value="1"/><inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/></inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><mesh filename="meshes/sr450_link_4.stl" scale="0.001 0.001 0.001"/></geometry>
            <material name="link_4_color"><color rgba="0.3 0.3 0.32 1"/></material>
        </visual>
    </link>
    <joint name="joint_flange" type="fixed">
        <origin xyz="0 0 0" rpy="0 3.14159265359 0"/>
        <parent link="link_4"/>
        <child link="flange"/>
    </joint>
    <link name="flange">
        <inertial><mass value="1"/><inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/></inertial>
    </link>
    <joint name="joint_adapter" type="fixed">
        <origin xyz="0 0 0" rpy="3.14159265359 0 3.14159265359"/>
        <parent link="flange"/>
        <child link="adapter"/>
    </joint>
    <link name="adapter">
        <inertial><mass value="1"/><inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/></inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 1.5707963268"/>
            <geometry><mesh filename="meshes/bosch_adapter.stl" scale="0.001 0.001 0.001"/></geometry>
            <material name="adapter_color"><color rgba="0.14 0.55 0.68 0.8"/></material>
        </visual>
    </link>
    <joint name="joint_hoop" type="fixed">
        <origin xyz="0 0 -0.008" rpy="0 0 0"/>
        <parent link="adapter"/>
        <child link="hoop"/>
    </joint>
    <link name="hoop">
        <inertial><mass value="1"/><inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/></inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 1.5707963268"/>
            <geometry><mesh filename="meshes/hoop.stl" scale="0.001 0.001 0.001"/></geometry>
            <material name="hoop_color"><color rgba="0.14 0.55 0.68 0.8"/></material>
        </visual>
    </link>
</robot>
